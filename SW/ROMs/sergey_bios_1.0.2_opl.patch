+	; channel 1
+	intel_music_1:
+			db   80, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0feh,   78, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh
+			db 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh
+			
+	; channel 2
+	intel_music_2:
+			db   85, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0feh,   73, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh
+			db 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh, 0ffh
